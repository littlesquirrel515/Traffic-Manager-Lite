TZ=Asia/Shanghai
TML_HTTP_PORT=18080
TML_LISTEN=:8080
TML_DB_PATH=/app/data/traffic.db
TML_BACKUP_DIR=/app/backups
TML_CONFIG_ROOT=/app/configs
TML_CONFIG_HOST_DIR=./configs
TML_COLLECT_INTERVAL=10s
TML_COLLECT_TIMEOUT=8s
TML_ACTIVE_WINDOW=60s
TML_TIMEZONE=Asia/Shanghai
TML_RAW_RETENTION_DAYS=30
TML_ARCHIVE_ENABLED=true
TML_LOG_LEVEL=info
TML_ADMIN_USER=admin
TML_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_AT_LEAST_16_CHARS
TML_SECURE_COOKIE=true
# Empty: authorize API endpoints saved by the administrator in the UI.
# Optional strict mode: exact DNS names, IPs or CIDRs (e.g. 172.18.0.0/16).
TML_ALLOWED_TARGETS=

# Optional v1.4 host configuration agent, disabled by default.
# Private host/bridge endpoint only; do not mount Docker Socket into TML.
TML_CORE_AGENT_URL=
TML_CORE_AGENT_TOKEN=
