TZ=Asia/Shanghai
TML_HTTP_PORT=18080
TML_LISTEN=:8080
TML_DB_PATH=/app/data/traffic.db
TML_BACKUP_DIR=/app/backups
TML_CONFIG_ROOT=/app/configs
TML_CONFIG_HOST_DIR=./configs
TML_COLLECT_INTERVAL=10s
TML_COLLECT_TIMEOUT=8s
TML_ACTIVE_WINDOW=60s
TML_TIMEZONE=Asia/Shanghai
TML_RAW_RETENTION_DAYS=30
TML_ARCHIVE_ENABLED=true
TML_LOG_LEVEL=info
TML_ADMIN_USER=admin
TML_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_AT_LEAST_16_CHARS
TML_SECURE_COOKIE=true
# Exact DNS names, IPs or CIDRs; explicitly add your proxy container names.
TML_ALLOWED_TARGETS=127.0.0.1,::1,xray,v2fly,singbox,hysteria2
